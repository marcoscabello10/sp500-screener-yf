{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/data.py": {
      "maxDuration": 30
    },
    "api/informe.py": {
      "maxDuration": 60,
      "includeFiles": "public/data/**"
    }
  },
  "rewrites": [
    { "source": "/informe", "destination": "/informe.html" }
  ]
}
